{
  "expo": {
    "name": "Marcha GPS",
    "slug": "marcha-gps",
    "scheme": "marchagps",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#070B12",
    "ios": {
      "bundleIdentifier": "br.com.marchagps.app",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "O Marcha GPS usa sua localização pra navegar, avisar de lombadas e mostrar seu carro pra sua equipe (se você quiser).",
        "NSCameraUsageDescription": "A câmera é usada pra fotografar seu carro e fazer a mídia nos eventos.",
        "NSPhotoLibraryUsageDescription": "O Marcha GPS usa suas fotos pra postar no feed."
      }
    },
    "android": {
      "package": "br.com.marchagps.app",
      "permissions": [
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION",
        "CAMERA"
      ]
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "@maplibre/maplibre-react-native",
      "expo-location",
      "expo-camera",
      [
        "expo-image-picker",
        {
          "photosPermission": "O Marcha GPS usa suas fotos pra postar no feed."
        }
      ]
    ],
    "newArchEnabled": true,
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./public/favicon.png",
      "name": "Marcha GPS",
      "shortName": "Marcha GPS",
      "lang": "pt-BR",
      "themeColor": "#070B12",
      "backgroundColor": "#070B12"
    }
  }
}

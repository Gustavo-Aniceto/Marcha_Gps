{
  "buildCommand": "npx expo export -p web",
  "outputDirectory": "dist",
  "rewrites": [{ "source": "/((?!_expo|assets|.*\\..*).*)", "destination": "/index.html" }],
  "headers": [
    { "source": "/manifest.json", "headers": [{ "key": "Content-Type", "value": "application/manifest+json" }] }
  ]
}

    {
      "id": "predios-3d",
      "type": "fill-extrusion",
      "source": "openmaptiles",
      "source-layer": "building",
      "minzoom": 14,
      "filter": [
        "!",
        [
          "has",
          "hide_3d"
        ]
      ],
      "paint": {
        "fill-extrusion-color": [
          "interpolate",
          [
            "linear"
          ],
          [
            "coalesce",

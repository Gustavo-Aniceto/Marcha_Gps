{
  "version": 8,
  "name": "marcha-dia",
  "sources": {
    "openmaptiles": {
      "type": "vector",
      "url": "https://tiles.openfreemap.org/planet"
    }
  },
  "glyphs": "https://tiles.openfreemap.org/fonts/{fontstack}/{range}.pbf",
  "layers": [
    {
      "id": "fundo",
      "type": "background",
      "paint": {
        "background-color": "#EEF1F6"
      }
    },
    {
      "id": "parques",
      "type": "fill",
      "source": "openmaptiles",
      "source-layer": "park",
      "paint": {
        "fill-color": "#CDE9C2"
      }
    },
    {
      "id": "verde",
      "type": "fill",
      "source": "openmaptiles",
      "source-layer": "landcover",
      "filter": [
        "in",
        [
          "get",
          "class"
        ],
        [
          "literal",
          [
            "grass",
            "wood"
          ]
        ]
      ],
      "paint": {
        "fill-color": "#CDE9C2",
        "fill-opacity": 0.7
      }
    },
    {
      "id": "agua",
      "type": "fill",
      "source": "openmaptiles",
      "source-layer": "water",
      "paint": {
        "fill-color": "#9CC9F0"
      }
    },
    {
      "id": "aeroporto",
      "type": "fill",
      "source": "openmaptiles",
      "source-layer": "aeroway",
      "filter": [
        "==",
        [
          "geometry-type"
        ],
        "Polygon"
      ],
      "paint": {
        "fill-color": "#C9D1E0",
        "fill-opacity": 0.6
      }
    },
    {
      "id": "ruas-contorno",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "transportation",
      "filter": [
        "in",
        [
          "get",
          "class"
        ],
        [
          "literal",
          [
            "primary",
            "secondary",
            "tertiary",
            "motorway",
            "trunk"
          ]
        ]
      ],
      "layout": {
        "line-cap": "round",
        "line-join": "round"
      },
      "paint": {
        "line-color": "#C9D1E0",
        "line-width": [
          "interpolate",
          [
            "exponential",
            1.5
          ],
          [
            "zoom"
          ],
          8,
          1.5,
          14,
          8,
          18,
          30
        ]
      }
    },
    {
      "id": "ruas-menores",
      "type": "line",
      "source": "openmaptiles",

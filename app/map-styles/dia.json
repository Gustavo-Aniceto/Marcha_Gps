      "id": "bairros-cidades",
      "type": "symbol",
      "source": "openmaptiles",
      "source-layer": "place",
      "filter": [
        "in",
        [
          "get",
          "class"
        ],
        [
          "literal",
          [
            "city",
            "town",
            "suburb",
            "neighbourhood",
            "quarter"
          ]
        ]
      ],
      "layout": {
        "text-field": [
          "get",
          "name"
        ],
        "text-font": [
          "Noto Sans Bold"
        ],
        "text-size": [
